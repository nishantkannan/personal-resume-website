# Copy this file to .env.local for local development, and add the same
# variables in Vercel under Project > Settings > Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form messages are delivered (your inbox).
CONTACT_TO_EMAIL=

# Sender shown on the emails. Leave blank to use Resend's test sender,
# which can only deliver to the email address on your Resend account.
# After verifying your own domain in Resend, use e.g. "Resume site <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Optional: your public site URL, used for social share links.
# Vercel fills this in automatically, so you only need it for a custom domain.
NEXT_PUBLIC_SITE_URL=
